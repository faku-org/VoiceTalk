# Copy to .env.local (gitignored) and fill in. `bun dev` loads it and the Tauri shell passes
# it on to the core and voice sidecars. Never commit real keys.

# --- Keys -----------------------------------------------------------------------------------
# Cartesia TTS (speech output). Required.
CARTESIA_API_KEY=
# Brain keys, only for the providers you pick in Preferencias > Asistente > Cerebro.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Optional key of the custom OpenAI-compatible brain.
VT_CUSTOM_LLM_KEY=

# --- Discord (optional) ---------------------------------------------------------------------
# Bot token and application id from the Discord Developer Portal (README, "Discord bot"). Without a
# token the feature is hidden. Bot tokens only: never a user token.
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# off = disable even with a token
VT_DISCORD=
# Words that address the agent when talking is on, comma-separated. Default: voicetalk,voice talk
VT_DISCORD_NAMES=
# name (answer only when addressed) or always. Default: name
VT_DISCORD_ADDRESS=
# Concurrent STT links in the voice sidecar (mic call + one per Discord speaker). Default: 8
VT_STT_MAX_CLIENTS=

# --- Brain ----------------------------------------------------------------------------------
# Fallback when there are no preferences: local, ollama, claude, openai, xai or custom. Preferencias win.
# `bun dev --local` defaults to local.
VT_BRAIN=local
# OpenAI-compatible endpoint. Core strips a trailing /v1; voice needs it (unset = no LLM post-correction).
VT_LLM_URL=http://127.0.0.1:8080/v1
VT_LLM_MODEL=
VT_EMBED_URL=http://127.0.0.1:8891/v1/embeddings
VT_EMBED_MODEL=embeddinggemma-2

# --- Local models (bun dev --local) ---------------------------------------------------------
# llama-server binary. Default: llama-server on PATH.
VT_LLAMA_SERVER=
# GGUF paths. Default: the file in the Hugging Face cache (~/.cache/huggingface/hub).
VT_LLM_GGUF=
VT_EMBED_GGUF=
# Extra llama-server flags for both servers. Default: -ngl 99
VT_LLAMA_ARGS=

# --- Data -----------------------------------------------------------------------------------
# Folders to ingest, ;-separated. Default: %USERPROFILE%\Documents\Personal
VT_FOLDERS=
# SQLite and index. Default: core/.data
VT_DATA_DIR=
# off = skip the folder watcher
VT_INGEST=
# off = no call recording and no notes decision model
VT_NOTES=
# off = call capture disabled for every user (it is also off by default in Preferencias)
VT_CAPTURE=
# Glossary TOML for STT post-correction. Default: voice/glossary.toml
VT_GLOSSARY=

# --- Shell overrides ------------------------------------------------------------------------
VT_BUN=
VT_UV=
VT_REPO_ROOT=
